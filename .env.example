# ============================================================================
#  Trading-Agent LLM Fine-tuning — configuration
#  Copy to .env (cp .env.example .env). Read by config.py; no code edits needed.
# ============================================================================

# ── Model / backend ─────────────────────────────────────────────────────────
BASE_MODEL=mlx-community/NVIDIA-Nemotron-3.5-Bolt-E4B-OptiQ-4bit
USE_OLLAMA=0
OLLAMA_MODEL=nemotron-bolt-e4b-16k
OLLAMA_URL=http://localhost:11434/api/chat
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=nemotron-trading

# ── What + when to simulate ─────────────────────────────────────────────────
SYMBOL=CANBK
START_DATE=2024-01-10
ROUNDS=5
EPISODES=50

# ── Training knobs (params.yaml is authoritative; these are env overrides) ──
MLX_ITERS=600
LORA_R=16
MLX_NUM_LAYERS=8
EPOCHS=2
SAVE_EVERY=100

# ── Locations ───────────────────────────────────────────────────────────────
DB_PATH=trading_agent.db
ADAPTER_DIR=output/adapters
DATA_DIR=data/rounds

# ── Simulation economics / mechanics ────────────────────────────────────────
INITIAL_CAP=10000
RISK_PER_TRADE=0.02
MAX_HOLD_DAYS=5
LOOKBACK_DAYS=30
DEATH_THRESHOLD=0.20

# ── Data sources (offline-friendly) ─────────────────────────────────────────
DATA_SOURCE=csv
CSV_DIR=data/prices
CSV_PATH=
FUNDAMENTALS_SOURCE=xbrl
XBRL_DIR=data/fundamentals

# ── Dataset split / cleaning ────────────────────────────────────────────────
SPLIT_MODE=time
BALANCE_DATA=1
DEDUP_DATA=1
REQUIRE_FUNDAMENTALS=0

# ── Experiment tracking (optional) ──────────────────────────────────────────
MLFLOW_TRACKING_URI=

# ── India VIX regime thresholds ─────────────────────────────────────────────
VIX_CSV=
VIX_LOW=13
VIX_NORMAL=18
VIX_ELEVATED=25

# ── Transaction costs (fees + taxes), folded into realised NET P&L ──────────
INCLUDE_COSTS=1
BROKERAGE_PCT=0.0003
BROKERAGE_MAX=20.0
STT_PCT=0.001
EXCH_TXN_PCT=0.0000297
SEBI_PCT=0.000001
GST_PCT=0.18
STAMP_PCT=0.00015

# ── VIX-based position sizing ───────────────────────────────────────────────
VIX_SIZING=1
VIX_QTY_LOW=1.5
VIX_QTY_NORMAL=1.0
VIX_QTY_ELEVATED=0.6
VIX_QTY_EXTREME=0.35
VIX_DIST_LOW=0.8
VIX_DIST_NORMAL=1.0
VIX_DIST_ELEVATED=1.4
VIX_DIST_EXTREME=1.8
