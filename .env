# ============================================================================
#  .env — single place to configure the whole pipeline.
# ============================================================================

BASE_MODEL=mlx-community/NVIDIA-Nemotron-3.5-Bolt-E4B-OptiQ-4bit

USE_OLLAMA=1
OLLAMA_MODEL=nemotron-bolt-e4b-16k
OLLAMA_URL=http://localhost:11434/api/chat

# ── PRICE DATA (local CSV; minute OR daily) ─────────────────────────────────
DATA_SOURCE=csv
CSV_DIR=data/prices
CSV_PATH=

# ── INDIA VIX (volatility regime context) ───────────────────────────────────
VIX_CSV=data/prices/INDIAVIX.csv
VIX_LOW=13
VIX_NORMAL=18
VIX_ELEVATED=25

# ── FUNDAMENTALS (official SEBI XBRL) ───────────────────────────────────────
FUNDAMENTALS_SOURCE=xbrl
XBRL_DIR=data/fundamentals

# ── DATA REPRESENTATION / QUALITY (smoother training, more ROI) ─────────────
RELATIVE_ENCODING=1          # add scale-free REL line + HEADLINE to prompts
DEDUP_DATA=1                 # drop near-duplicate setups
BALANCE_DATA=1               # cap majority BUY/SELL side at 1.5x the minority
SPLIT_MODE=time              # time = walk-forward (test=latest dates); or random

# ── SIMULATION SCOPE ────────────────────────────────────────────────────────
SYMBOL=CANBK
START_DATE=2024-01-10
ROUNDS=5
EPISODES=50

# ── TRAINING (MLX LoRA) ─────────────────────────────────────────────────────
MLX_ITERS=600                # SMOKE TEST: 50
LORA_R=16
MLX_NUM_LAYERS=8
EPOCHS=2
SAVE_EVERY=100

# ── PATHS ───────────────────────────────────────────────────────────────────
DB_PATH=trading_agent.db
ADAPTER_DIR=output/adapters
DATA_DIR=data/rounds

# ── CAPITAL / RISK ──────────────────────────────────────────────────────────
INITIAL_CAP=10000
RISK_PER_TRADE=0.02
MAX_HOLD_DAYS=5
LOOKBACK_DAYS=30

MLFLOW_TRACKING_URI=
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=nemotron-trading
