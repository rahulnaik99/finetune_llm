# ============================================================================
#  .env — single place to configure the whole pipeline. Edit values here;
#         never edit the Python code. CLI flags (if passed) still override these.
# ============================================================================

# ── WHAT MODEL TO FINE-TUNE (student) ───────────────────────────────────────
BASE_MODEL=mlx-community/NVIDIA-Nemotron-3.5-Bolt-E4B-OptiQ-4bit

# ── WHO GENERATES THE TRAINING DATA (teacher) ───────────────────────────────
# USE_OLLAMA=1  -> Nemotron teacher via Ollama writes the decisions (REAL data)
# USE_OLLAMA=0  -> rule-based fallback (fast smoke test, low-quality data)
USE_OLLAMA=1
OLLAMA_MODEL=nemotron-bolt-e4b-16k
OLLAMA_URL=http://localhost:11434/api/chat

# ── SIMULATION SCOPE ────────────────────────────────────────────────────────
SYMBOL=CANBK
START_DATE=2024-01-10
ROUNDS=5
EPISODES=50

# ── TRAINING (MLX LoRA on Apple Silicon) ────────────────────────────────────
# SMOKE TEST (fast, ~2-3 min training): MLX_ITERS=50
# REAL RUN   (good quality, ~0.9h):     MLX_ITERS=600
MLX_ITERS=600
LORA_R=16
MLX_NUM_LAYERS=8
EPOCHS=2
SAVE_EVERY=100

# ── PATHS ───────────────────────────────────────────────────────────────────
DB_PATH=trading_agent.db
ADAPTER_DIR=output/adapters
DATA_DIR=data/rounds

# ── SIMULATION CAPITAL / RISK (optional — read by simulation.py) ────────────
INITIAL_CAP=10000
RISK_PER_TRADE=0.02
MAX_HOLD_DAYS=5
LOOKBACK_DAYS=30

# ── EXPERIMENT TRACKING (optional) ──────────────────────────────────────────
MLFLOW_TRACKING_URI=

# ── vLLM SERVING (optional, NVIDIA only) ────────────────────────────────────
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=nemotron-trading

# ============================================================================
#  QUICK RECIPES (change values, then run:  python flywheel.py)
#    SMOKE TEST:  USE_OLLAMA=1  ROUNDS=1  EPISODES=20  MLX_ITERS=50
#    REAL RUN:    USE_OLLAMA=1  ROUNDS=5  EPISODES=50  MLX_ITERS=600
#    500+ examples: run multiple symbols (change SYMBOL, re-run; appends to DB)
# ============================================================================
