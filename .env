BASE_MODEL=mlx-community/NVIDIA-Nemotron-3.5-Bolt-E4B-OptiQ-4bit

USE_OLLAMA=1
OLLAMA_MODEL=nemotron-bolt-e4b-16k
OLLAMA_URL=http://localhost:11434/api/chat

DATA_SOURCE=csv
CSV_DIR=data/prices
CSV_PATH=

VIX_CSV=data/prices/INDIAVIX.csv
VIX_LOW=13
VIX_NORMAL=18
VIX_ELEVATED=25

FUNDAMENTALS_SOURCE=xbrl
XBRL_DIR=data/fundamentals
FUNDAMENTALS_NATURE=Standalone

RELATIVE_ENCODING=1
DEDUP_DATA=1
BALANCE_DATA=1
SPLIT_MODE=time
# Fundamentals are OPTIONAL context (15-year training). Each example is tagged
# fund_completeness = fresh / stale / none. Set REQUIRE_FUNDAMENTALS=1 to drop
# examples without fresh fundamentals (default 0 = keep all, just tag them).
REQUIRE_FUNDAMENTALS=0

SYMBOL=CANBK
START_DATE=2015-01-10
ROUNDS=5
EPISODES=50

MLX_ITERS=600
LORA_R=16
MLX_NUM_LAYERS=8
EPOCHS=2
SAVE_EVERY=100

DB_PATH=trading_agent.db
ADAPTER_DIR=output/adapters
DATA_DIR=data/rounds

INITIAL_CAP=10000
RISK_PER_TRADE=0.02
MAX_HOLD_DAYS=5
LOOKBACK_DAYS=30

MLFLOW_TRACKING_URI=
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=nemotron-trading
